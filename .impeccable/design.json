  "narrative": {
    "northStar": "大字宣纸册子",
    "overview": "像一本大字本的宣纸册子，不像一个道观网页。宣纸为底、墨字为骨、赭石为界、朱砂为印。目标用户 35–70 岁，不熟悉术语，所以字号更大、对比更高、装饰更少。传统感来自纸张、留白与印章，而非暗色、金色或混用字族。",
    "keyCharacteristics": [
      "暖白宣纸铺底，墨色正文 17px、行高 1.85，赭石 1px 发丝线勾结构。",
      "朱砂只给主按钮、印章、关键数字，一屏面积不超过 10%。",
      "全站单一黑体族：标题、正文、数字、控件同族，靠字号/字重/字距/颜色分层，不引入第二种字体。",
      "卡片大圆角、极轻纸色渐层与 0.05 柔和阴影；不堆投影、不用重阴影。"
    ],
    "rules": [
      { "name": "The Paper-Only Rule", "body": "全站宣纸底。导航、表单、结果同一套暖白，不切换暗色主题。", "section": "colors" },
      { "name": "The Seal Rule", "body": "朱砂用量以一枚印为上限：主按钮、钤印、关键数字。不做正文、不做图标填充、不做选中角标。", "section": "colors" },
      { "name": "The Readable Floor Rule", "body": "面向用户阅读的文字最小 13px，正文 17px。专业表格与分数注解可更小，但须折叠在「详细」区。", "section": "typography" },
      { "name": "The Single Family Rule", "body": "全站只用一套黑体字族；标题、正文、按钮、表单、提示、数字同族，层级靠字号/字重/字距/颜色，不混用衬线体。", "section": "typography" },
      { "name": "The Light Touch Rule", "body": "卡片可有极淡纸色渐层与 rgba(36,31,23,.05) 的柔和阴影；禁止深色投影、发光与渐变文字。", "section": "elevation" }
    ],
    "dos": [
      "Do 用暖白纸色，不用纯白或纯黑。",
      "Do 正文 17px 起，行高 ≥1.8，面向 35–70 岁保证可读。",
      "Do 用 1px 发丝线与纸色差分层。",
      "Do 选中态用赭石底+边，让状态不只靠颜色。",
      "Do 主操作固定在底部拇指区，按下变色且轻微缩放。",
      "Do 尊重 prefers-reduced-motion；焦点只在 :focus-visible 出现。"
    ],
    "donts": [
      "Don't 用暗底+金字的旧版组合。",
      "Don't 用金色、发光、渐变文字、深色神秘风。",
      "Don't 把朱砂用于正文、大面积背景或选中角标。",
      "Don't 让面向阅读的正文小于 13px。",
      "Don't 用太极、八卦、龙、符咒做装饰（卦象作为罗盘刻度数据除外）。",
      "Don't 用 emoji 或 Unicode 符号当功能图标。",
      "Don't 用颜色单独承载状态；吉/凶、选中/未选中都须有文字或形状双重提示。"
    ]
  }
