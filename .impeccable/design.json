  "narrative": {
    "northStar": "铜镜与宣纸",
    "overview": "界面只承认两种物质：一块墨玉底上的黄铜罗盘，和一张写满批注的宣纸。罗盘是尺，负责输入与方位；宣纸是纸，负责结论。所有设计判断都回到这两个比喻：它是不是刻在铜上的一根线，还是落在纸上的一笔字。这套系统拒绝深色科技风的默认装饰：没有渐变文字，没有发光卡片，没有圆角浮层。深度靠色阶与发丝线，不靠阴影堆叠；强调靠字重与字号，不靠第二套亮色。唯一的暖色行动色是朱砂，且只出现在钤印与主操作上——它的稀有是刻意的。",
    "keyCharacteristics": [
      "墨玉三阶铺底，黄铜发丝线勾结构，宣纸只承载结果。",
      "直角优先（0–1px），圆只属于罗盘与印。",
      "宋体作显示与标题，黑体作正文；小字不低 9.5px，且必须过 4.5:1。",
      "动效只服务两处：盘面入场、纸面落定。"
    ],
    "rules": [
      { "name": "The Paper-Only Rule", "body": "宣纸色只用于结果：批注、印章、报告里的表格。导航、表单、设置永远留在墨玉上。", "section": "colors" },
      { "name": "The Seal Rule", "body": "朱砂的用量以一枚印为上限：主按钮、钤印、区块标记。它不做背景、不做正文、不做图标填充色。", "section": "colors" },
      { "name": "The Label Floor Rule", "body": "小于 9.5px 的字不存在。9.5–12px 的字必须达到 4.5:1，否则提亮，不靠加粗补偿。", "section": "typography" },
      { "name": "The Two Faces Rule", "body": "宋体只做标题、题目、批语与数字；黑体只做正文、按钮、表单与提示。不新增第三种字体。", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "静止状态没有阴影；阴影只属于被拿起来的一张纸和挡住页面的一层幕。", "section": "elevation" }
    ],
    "dos": [
      "Do 用 1px 发丝线与明度阶表达结构，阴影只给纸与幕。",
      "Do 把结果放进宣纸，把操作留在墨玉。",
      "Do 保持 0–1px 圆角；圆只给罗盘、印与状态点。",
      "Do 主操作固定在拇指区，并在报告底部给再算一次 / 复制 / 存图。",
      "Do 单选组用 radiogroup + aria-checked，点击目标 ≥44×44。",
      "Do 所有小字过 4.5:1；9.5px 是下限。",
      "Do 数字由工具层算，模型只负责叙述；分数必须有单位。"
    ],
    "donts": [
      "Don't 用原生 optgroup 做分组选择：暗色下标签会白字白底。",
      "Don't 用渐变文字、发光卡片、圆角浮层、卡片套卡片。",
      "Don't 把朱砂用于正文或大面积背景。",
      "Don't 用 emoji 或 Unicode 字符当图标。",
      "Don't 在标题上方加 kicker/eyebrow 小标签。",
      "Don't 让删除按钮默认获得焦点，或把 16px 的 × 放在拇指热区。",
      "Don't 用颜色单独承载状态（吉/凶必须同时有文字）。",
      "Don't 在 390px 下让表格首列换行或页面横向滚动。"
    ]
  }
}
