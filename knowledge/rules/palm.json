{
  "version": 1,
  "kind": "palm",
  "notes": "手相规则：判据来自 21 点手部关键点测量，依据为《麻衣神相》掌型五行与指长条目。",
  "rules": [
    {
      "id": "palm-wood",
      "field": "shape",
      "value": "wood",
      "title": "掌长而瘦，木形掌",
      "when": { "palmRatio": { "min": 1.4 } },
      "basis": ["my-sx-05"],
      "reason": "掌长/掌宽 ≥ 1.4"
    },
    {
      "id": "palm-metal",
      "field": "shape",
      "value": "metal",
      "title": "掌方而坚，金形掌",
      "when": { "palmRatio": { "between": [1.2, 1.4] } },
      "basis": ["my-sx-05"],
      "reason": "掌长/掌宽 1.2–1.4"
    },
    {
      "id": "palm-water",
      "field": "shape",
      "value": "water",
      "title": "掌圆而软，水形掌",
      "when": { "palmRatio": { "between": [1.0, 1.2] } },
      "basis": ["my-sx-05"],
      "reason": "掌长/掌宽 1.0–1.2"
    },
    {
      "id": "palm-earth",
      "field": "shape",
      "value": "earth",
      "title": "掌厚而方，土形掌",
      "when": { "palmRatio": { "max": 1.0 } },
      "basis": ["my-sx-05"],
      "reason": "掌长/掌宽 ≤ 1.0"
    },
    {
      "id": "finger-long",
      "field": "finger",
      "value": "long",
      "title": "指长掌短，偏思",
      "when": { "fingerPalmRatio": { "min": 1.0 } },
      "basis": ["my-sx-07"],
      "reason": "中指长/掌长 ≥ 1.0"
    },
    {
      "id": "finger-short",
      "field": "finger",
      "value": "short",
      "title": "指短掌长，偏行",
      "when": { "fingerPalmRatio": { "max": 0.8 } },
      "basis": ["my-sx-07"],
      "reason": "中指长/掌长 ≤ 0.8"
    },
    {
      "id": "finger-index",
      "field": "finger",
      "value": "index",
      "title": "食指偏长",
      "when": { "indexRingRatio": { "min": 1.03 } },
      "basis": ["my-sx-07"],
      "reason": "食指/无名指 ≥ 1.03"
    },
    {
      "id": "finger-ring",
      "field": "finger",
      "value": "ring",
      "title": "无名指偏长",
      "when": { "indexRingRatio": { "max": 0.9 } },
      "basis": ["my-sx-07"],
      "reason": "食指/无名指 ≤ 0.9"
    }
  ],
  "modelOnlyFields": ["hand", "thick", "life", "head", "heart", "fate", "mount", "mark"],
  "modelOnlyNote": "掌厚、三线、掌丘与掌纹标记无法由 21 点稳定测量，交给视觉模型。"
}
